#!/bin/bash

usage() {
    echo "Usage: $0 [-c|--compress] [-r|--record] [-h|--help]"
    exit 1
}

# Initialize variables with default values
DO_RECORD=false
DO_COMPRESS=false

# Loop through all arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        -c|--compress)
            DO_COMPRESS=true
            shift  # Past flag
            ;;
        -r|--record)
            DO_RECORD=true
            shift  # Past flag
            ;;
        -h|--help)
            usage
            ;;
        *)
            echo "Unknown option: $1"
            usage
            ;;
    esac
done


bindir=$(cd -- "$(dirname -- "${0}")" && pwd)
basedir=$(dirname -- "${bindir}")
username=$(basename $(dirname -- "${basedir}"))

d=$(date)
/bin/echo "${d}: startup.bsh invoked; waiting for 10s..." >> /home/pi/logs/dvr-startup.log
sleep 10

who=$(whoami)
d=$(date)
host=$(hostname)
dvrlog="/home/${username}/logs/dvr-startup.log"
echo "${d}: whoami returned \"${who}\"" >> "${dvrlog}"
echo "${d}: hostname returned \"${host}\"" >> "${dvrlog}"

d=$(date)
if [[ "${DO_COMPRESS}" == "true" ]]; then
    "${basedir}/bin/launch-compressd.bsh" &
fi

d=$(date)
if [[ "${DO_RECORD}" == "true" ]]; then
    "${basedir}/bin/launch-recorderd.bsh" &
fi


